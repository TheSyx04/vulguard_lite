#!/usr/bin/env bash
# Fixed-threshold inference only: 2 datasets x 3 CPU models.
# Eight workers consume the 96-task matrix with stride 8.
# Submit: qsub -v HF_TOKEN scripts/reinfer_openssl_latest_cpu_sutd.pbs
#
#PBS -N th05_infer_c
#PBS -q v100q
#PBS -l select=1:mem=10GB:ncpus=2:host=aimc-gn3
#PBS -l walltime=48:00:00
#PBS -P 20260203
#PBS -J 0-7
#PBS -j oe
#PBS -o /scratch/congthanh_le/quan/vulguard_logs/overall/threshold_0.5_cpu.log

set -euo pipefail

SERVER_ROOT="${SERVER_ROOT:-/scratch/congthanh_le/quan}"
REPO_DIR="${REPO_DIR:-$SERVER_ROOT/vulguard_lite}"
export SERVER_ROOT REPO_DIR
export DATASETS="${DATASETS:-linux;openssl}"
export MODELS="${MODELS:-tlel;lapredict;lr}"
export EXECUTION_KIND="cpu"
export CPU_THREADS="${CPU_THREADS:-2}"
export TASK_STRIDE="${TASK_STRIDE:-8}"

exec bash "$REPO_DIR/scripts/reinfer_openssl_latest_sutd_worker.sh"
