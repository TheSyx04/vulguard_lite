#!/usr/bin/env bash
# Fixed-threshold OpenSSL inference: DeepJIT and SimCom run all 12 valid splits;
# JITFine runs only 1_1, 1_3, 2_2, 3_1 and 3_3. Two GPU workers use stride 2.
# Submit: qsub -v HF_TOKEN scripts/reinfer_openssl_latest_gpu_sutd.pbs
#
#PBS -N th05_infer_g
#PBS -q v100q
#PBS -l select=1:mem=30GB:ncpus=4:ngpus=1
#PBS -l walltime=48:00:00
#PBS -P 20260203
#PBS -J 0-1
#PBS -j oe
#PBS -o /scratch/congthanh_le/quan/vulguard_logs/overall/threshold_0.5_gpu.log

set -euo pipefail

SERVER_ROOT="${SERVER_ROOT:-/scratch/congthanh_le/quan}"
REPO_DIR="${REPO_DIR:-$SERVER_ROOT/vulguard_lite}"
export SERVER_ROOT REPO_DIR
export TASKS="${TASKS:-openssl:deepjit:openssl_0_1;openssl:deepjit:openssl_0_2;openssl:deepjit:openssl_0_3;openssl:deepjit:openssl_1_1;openssl:deepjit:openssl_1_2;openssl:deepjit:openssl_1_3;openssl:deepjit:openssl_2_1;openssl:deepjit:openssl_2_2;openssl:deepjit:openssl_2_3;openssl:deepjit:openssl_3_1;openssl:deepjit:openssl_3_2;openssl:deepjit:openssl_3_3;openssl:simcom:openssl_0_1;openssl:simcom:openssl_0_2;openssl:simcom:openssl_0_3;openssl:simcom:openssl_1_1;openssl:simcom:openssl_1_2;openssl:simcom:openssl_1_3;openssl:simcom:openssl_2_1;openssl:simcom:openssl_2_2;openssl:simcom:openssl_2_3;openssl:simcom:openssl_3_1;openssl:simcom:openssl_3_2;openssl:simcom:openssl_3_3;openssl:jitfine:openssl_1_1;openssl:jitfine:openssl_1_3;openssl:jitfine:openssl_2_2;openssl:jitfine:openssl_3_1;openssl:jitfine:openssl_3_3}"
export EXECUTION_KIND="gpu"
export CPU_THREADS="${CPU_THREADS:-4}"
export TASK_STRIDE="${TASK_STRIDE:-2}"

exec bash "$REPO_DIR/scripts/reinfer_openssl_latest_sutd_worker.sh"
