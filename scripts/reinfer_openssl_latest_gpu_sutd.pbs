#!/usr/bin/env bash
# Fixed-threshold inference only: 2 datasets x 3 GPU models.
# Exactly two workers/GPUs consume the 96-task matrix with stride 2.
# Submit: qsub -v HF_TOKEN scripts/reinfer_openssl_latest_gpu_sutd.pbs
#
#PBS -N th05_infer_g
#PBS -q v100q
#PBS -l select=1:mem=10GB:ncpus=4:ngpus=1
#PBS -l walltime=48:00:00
#PBS -P 20260203
#PBS -J 0-1
#PBS -j oe
#PBS -o /scratch/congthanh_le/quan/vulguard_logs/overall/threshold_0.5_gpu.log

set -euo pipefail

SERVER_ROOT="${SERVER_ROOT:-/scratch/congthanh_le/quan}"
REPO_DIR="${REPO_DIR:-$SERVER_ROOT/vulguard_lite}"
export SERVER_ROOT REPO_DIR
export DATASETS="${DATASETS:-linux;openssl}"
export MODELS="${MODELS:-deepjit;simcom;jitfine}"
export EXECUTION_KIND="gpu"
export CPU_THREADS="${CPU_THREADS:-4}"
export TASK_STRIDE="${TASK_STRIDE:-2}"

exec bash "$REPO_DIR/scripts/reinfer_openssl_latest_sutd_worker.sh"
